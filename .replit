run = "pip install -r requirements.txt && waitress-serve --port=5000 complete_platform_final:app"
modules = ["python-3.10"]

[nix]
channel = "stable-23_11"

[unitTest]
language = "python3"

[languages.python3]
pattern = "**/*.py"

[languages.python3.LSP]
start = "pylsp"

[packager]
language = "python3"
ignoredPackages = ["unit_tests"]

[env]
PYTHONUNBUFFERED = "1"
FLASK_ENV = "production"
FLASK_DEBUG = "0"

[deployment]
run = ["sh", "-c", "pip install -r requirements.txt && waitress-serve --port=$PORT complete_platform_final:app"]
